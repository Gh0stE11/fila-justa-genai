# Copie para .env e preencha. NUNCA faça commit do .env.
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx

# Modelo principal (qualquer id listado em https://openrouter.ai/models)
OPENROUTER_MODEL=openai/gpt-4o-mini
# Modelos de reserva, separados por vírgula (usados se o principal falhar). Opcional.
# Confira na página de modelos do OpenRouter se os ids ainda existem.
OPENROUTER_FALLBACK_MODELS=

LLM_TEMPERATURE=0
LLM_MAX_TOKENS=600
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
# json_schema (padrão) | json_object | prompt_only
LLM_RESPONSE_MODE=json_schema
# true = o OpenRouter só roteia para provedores que aceitam response_format
LLM_REQUIRE_PARAMETERS=false
